<mujoco model="go2 stairs scene">
  <include file="{{GO2_XML}}"/>

  <statistic center="1.5 0 0.3" extent="3.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="135" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
      rgb1="0.22 0.28 0.32" rgb2="0.14 0.18 0.22" markrgb="0.8 0.8 0.8"
      width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="8 8" reflectance="0.2"/>
    <material name="stairs" rgba="0.55 0.58 0.62 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 3.0" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="20 20 0.05" material="groundplane" friction="0.8 0.02 0.01"/>

    <!-- Five 5 cm steps beginning 1.2 m in front of the robot. -->
    <geom name="step_1" type="box" pos="1.35 0 0.025" size="0.15 1.0 0.025" material="stairs" friction="0.8 0.02 0.01"/>
    <geom name="step_2" type="box" pos="1.65 0 0.050" size="0.15 1.0 0.050" material="stairs" friction="0.8 0.02 0.01"/>
    <geom name="step_3" type="box" pos="1.95 0 0.075" size="0.15 1.0 0.075" material="stairs" friction="0.8 0.02 0.01"/>
    <geom name="step_4" type="box" pos="2.25 0 0.100" size="0.15 1.0 0.100" material="stairs" friction="0.8 0.02 0.01"/>
    <geom name="step_5" type="box" pos="2.55 0 0.125" size="0.15 1.0 0.125" material="stairs" friction="0.8 0.02 0.01"/>
    <geom name="top_platform" type="box" pos="3.70 0 0.125" size="1.0 1.0 0.125" material="stairs" friction="0.8 0.02 0.01"/>
  </worldbody>
</mujoco>
