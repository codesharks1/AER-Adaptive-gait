<mujoco model="go2 flat scene">
  <!-- 引入机器人本体模型。运行脚本会将占位符替换为实际的 Go2 XML 路径。 -->
  <include file="D:\RobotProject\simtosim\urdf_to_mjcf\robot.xml"/>

  <!-- 设置模型的统计中心和显示范围，主要影响查看器的默认取景。 -->
  <statistic center="0 0 0.25" extent="1.2"/>

  <!-- 配置查看器中的光照、雾色和默认相机角度。 -->
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="135" elevation="-20"/>
  </visual>

  <!-- 定义场景会用到的纹理和材质资源。 -->
  <asset>
    <!-- 使用内置渐变纹理生成天空背景。 -->
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <!-- 使用内置棋盘格纹理生成地面图案。 -->
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
      rgb1="0.22 0.28 0.32" rgb2="0.14 0.18 0.22" markrgb="0.8 0.8 0.8"
      width="300" height="300"/>
    <!-- 将棋盘格纹理封装为可供 geom 引用的地面材质。 -->
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="8 8" reflectance="0.2"/>
  </asset>

  <!-- worldbody 中放置固定在世界坐标系下的场景物体。 -->
  <worldbody>
    <!-- 从场景上方向下照射的平行光。 -->
    <light pos="0 0 2.0" dir="0 0 -1" directional="true"/>
    <!-- 平坦地面；friction 依次表示滑动、扭转和滚动摩擦参数。 -->
    <geom name="floor" type="plane" size="20 20 0.05" material="groundplane" friction="0.8 0.02 0.01"/>
  </worldbody>
</mujoco>
